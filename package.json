{
  "name": "alexlewin-card",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "test": "node --test --experimental-test-coverage 'tests/*.test.js'",
    "build": "node scripts/build-vcf.mjs && node scripts/build-vip.mjs",
    "qr": "node scripts/make-qr.mjs",
    "deploy": "pnpm build && vercel deploy site --prod --yes",
    "pass:art": "node scripts/render-pass.mjs",
    "pass:sign": "node scripts/sign-pass.mjs",
    "vip:rotate": "node scripts/build-vip.mjs --rotate",
    "test:e2e": "node --test 'tests/e2e/*.test.js'"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4"
  }
}
